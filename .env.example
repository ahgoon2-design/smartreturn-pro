# 이 파일은 개발자가 복사해서 `.env`를 만들기 위한 예시 파일이다.
# 실제 운영 비밀번호, 실제 secret, 실제 Google credential 경로를 넣지 않는다.

APP_NAME=SmartReturn Pro
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://smartreturn_user:smartreturn_password@localhost:5432/smartreturn_pro
SECRET_KEY=change-me-local-only
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FILE_STORAGE_ROOT=./storage
LOCAL_AGENT_BASE_URL=http://127.0.0.1:8765
