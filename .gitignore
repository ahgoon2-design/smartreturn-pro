# 환경/비밀값
.env
.env.*
!.env.example
*.secret
local.secret
config.json
secrets/
*.pem
*.key
*.local.json
*.secret.json
config.local.json
local.secret.json
backend/config.local.json
backend/local.secret.json
backend/*.local.json
backend/*.secret.json
!backend/local.secret.example.json
backend/uploads/
backend/pytest-cache-files*/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml

# Node/Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.npm-cache/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 브라우저 테스트(Playwright MCP) 산출물
.playwright-mcp/

# 로컬 AI 작업 산출물(추적 제외). .claude/agents 와 ai-harness 는 추적 대상이므로 ignore하지 않는다.
.claude/skills/
지시문/

# 로컬 설정 (프로젝트별 로컬 설정은 커밋하지 않음)
settings.json
**/settings.json

# 로그/출력/임시
logs/
outputs/
tmp/
tmp*/
temp/
*.log
*.tmp
*.bak

# 임시 테스트 산출물
.tmp-tests/
tmp_probe_write.txt

# 캐시
cache/

# 배포/압축/실행파일
dist/
build/
*.zip
*.exe
*.msi

# Local Agent
local_agent/config.json
local_agent/logs/
local_agent/outputs/
local_agent/dist/
local_agent/build/

# consensus-loop 실행 산출물 (하위 .gitignore와 이중 방어)
ai-harness/consensus-loop/consensus-runs/*
!ai-harness/consensus-loop/consensus-runs/.gitkeep

# 루트 검증 스크린샷 산출물 (브라우저 검증용 임시 이미지, 저장소 루트에만 적용)
/*.png
/*.jpg
/*.jpeg

# 파일 기반 루프 작업 폴더 (로컬 기록, 커밋 안 함; README와 _template만 추적)
ai-harness/loop/SPEC-*/
ai-harness/loop/LOOP-*/
ai-harness/loop/_done/
